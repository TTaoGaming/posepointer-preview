    "traced": "Great job! You traced {name}.",
    "filled": "Great job! You filled {name}.",
    "praise": "Great job!",
    "hoverOn": "Hover mode: hold still on a button or the glowing dot",
    "hoverOff": "Hover mode off: press to trace",
    "hoverOnLabel": "Hover mode: on. Hold the pointer still on a button or dot to press it.",
    "hoverOffLabel": "Hover mode: off. Hold the pointer still on a button or dot to press it.",
    "soundOn": "Sound: on",
    "soundOff": "Sound: off"
  },
  "canvas": {
    "rulers": [
      {
        "y": 10,
        "color": "#dbe4fb",
        "dash": [
          10,
          10
        ],
        "width": 2
      },
      {
        "y": 60,
        "color": "#dbe4fb",
        "dash": [
          10,
          10
        ],
        "width": 2
      },
      {
        "y": 100,
        "color": "#9fb3ec",
        "dash": [],
        "width": 3
      },
      {
        "y": 130,
        "color": "#e6ecfb",
        "dash": [
          3,
          9
        ],
        "width": 2
      }
    ],
    "rulerInset": 12,
    "guide": "#d9e5ff",
    "guideWidth": 11,
    "dashColor": "#8fa6ea",
    "dashWidth": 1.1,
    "minDashWidth": 2,
    "dashMark": 2,
    "dashGap": 5,
    "minDashGap": 10,
    "done": "#2fb86b",
    "progress": "#8be0b3",
    "trail": "rgba(255,112,40,0.88)",
    "trailWidth": 14,
    "trailLimit": 4000,
    "trailTrim": 1000,
    "rainbow": [
      "#ff6b6b",
