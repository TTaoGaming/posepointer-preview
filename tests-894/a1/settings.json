  "copy": {
    "upper": "capital {key}",
    "lower": "small {key}",
    "keyLabel": "Letter {name}",
    "shapeLabel": "Shape {key}",
    "board": "Tracing board: {label}, {count} {unit}",
    "stroke": "stroke",
