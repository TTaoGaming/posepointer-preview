{
  "adapters": {"stroke_data":"pointlist","trace_rule":"stroke","view":"canvas"},
  "sources": {
    "pointlist": "data/pointlist.json",
    "svgpath": "data/svgpath.json",
    "lessons": "data/lessons.json",
    "audioManifest": "old/audio/manifest.json",
    "audioBase": "old/audio/"
  },
  "defaultGlyph": "A",
  "tolerance": "gentle",
  "curveSteps": 16,
  "dotSpacing": 24,
  "layout": {
    "width": 100,
    "height": 140,
    "padding": 18,
    "minScale": 0.5,
    "maxDpr": 3
  },
  "fill": {
    "cell": 2,
    "thick": 22,
    "brush": 10,
    "goal": 0.8
  },
  "interaction": {
    "tipMs": 2200,
    "firstHintMs": 350,
    "restartHintMs": 150,
    "nextTapMs": 900,
    "dwellStartMs": 500,
    "dwellButtonMs": 900,
    "dwellRadius": 0.9,
    "dwellLeave": 1.3,
    "starsKey": "letterTracing.stars"
  },
  "audio": {
    "rate": 0.8,
    "pitch": 1.1,
    "language": "en-US",
    "timeoutMs": 2500,
    "msPerChar": 120,
    "gapMs": 120
