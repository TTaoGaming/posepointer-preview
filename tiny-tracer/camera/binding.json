{
  "schema": 1,
  "product": "tinytracer",
  "app": "letter-trace",
  "sense": { "id": "mediapipe-hands", "hands": 1, "camera": { "profile": "standard" }, "delegate": "CPU" },
  "cursor": { "id": "fingertip", "tip": 8 },
  "filter": { "id": "one-euro", "predictionMs": 20, "minCutoffHz": 3 },
  "interaction": {
    "id": "modes",
    "mode": "pen",
    "hand": "either",
    "touchQuietMs": 1000,
    "pen": {
      "lostMs": 300,
      "margin": 0.01,
      "layouts": {
        "landscape": {
          "paper": { "x0": 0, "y0": 0, "x1": 1, "y1": 1 },
          "silent": [{ "x0": 0, "y0": 0, "x1": 1, "y1": 0.005 }]
        },
        "portrait": {
          "paper": { "x0": 0, "y0": 0, "x1": 1, "y1": 1 },
          "silent": [{ "x0": 0, "y0": 0, "x1": 1, "y1": 0.005 }]
        }
      }
    },
    "tap": {
      "dwell": {
        "dwellMs": 1200, "settleMs": 400, "settlePx": 20, "refWidthPx": 1280,
        "enterRadius": 0.035, "leaveRadius": 0.07, "drainRate": 2,
        "lostMs": 300, "minFps": 5, "fpsWindowMs": 1000, "aspect": 0.5625
      }
    }
  },
  "sink": { "id": "tracer-pointer" },
  "overlays": [
    { "id": "cursor-ring" },
    { "id": "hand-skin", "skin": "wireframe" },
    { "id": "mirror", "opacity": 0.35 }
  ],
  "safety": { "activeHandLock": true, "killSwitch": true, "stallRelease": true, "stallMs": 500 }
}
